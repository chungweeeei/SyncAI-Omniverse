<?xml version="1.0" ?>
<sdf version="1.8">
  <model name='sync-robot' canonical_link='base_link'>

    <!-- Robot Base -->
    <link name='base_link'>
      <must_be_base_link>true</must_be_base_link>
      <visual name="base_link_visual">
        <geometry>
          <box><size>0.42 0.31 0.18</size></box>
        </geometry>
        <material>
          <ambient>0 1 1 1</ambient>
          <diffuse>0 1 1 1</diffuse>
        </material>
      </visual>

      <collision name="base_link_collision">
        <geometry>
          <box><size>0.42 0.31 0.18</size></box>
        </geometry>
      </collision>
    </link>

    <!-- Robot Footprint -->
    <link name='base_footprint'>
      <pose relative_to="base_joint"/>
      <inertial>
        <pose>0 0 0 1.5708 0 1.5708</pose>
        <mass>15</mass>
        <inertia>
          <ixx>0.261</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.341</iyy>
          <iyz>0.0</iyz>
          <izz>0.161</izz>
        </inertia>
      </inertial>
    </link>

    <joint name='base_joint' type='fixed'>
      <parent>base_link</parent>
      <child>base_footprint</child>
      <pose relative_to="base_link">0.0 0.0 -0.15 0 0 0</pose>
    </joint>

    <!-- Left Wheel -->
    <link name="drivewhl_l_link">
      <pose relative_to="drivewhl_l_joint"/>
      <visual name="drivewhl_l_link_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1.0</ambient>
          <diffuse>0.7 0.7 0.7 1.0</diffuse>
        </material>
      </visual>
      <collision name="drivewhl_l_link_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <pose>0 0 0 1.5708 0 0</pose>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00132</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00132</iyy>
          <iyz>0.0</iyz>
          <izz>0.0025</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="drivewhl_l_joint" type="revolute">
      <parent>base_link</parent>
      <child>drivewhl_l_link</child>
      <pose relative_to="base_link">0.0 0.18 -0.05 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
      </axis>
    </joint>

    <!-- Right Wheel -->
    <link name="drivewhl_r_link">
      <pose relative_to="drivewhl_r_joint"/>
      <visual name="drivewhl_r_link_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1.0</ambient>
          <diffuse>0.7 0.7 0.7 1.0</diffuse>
        </material>
      </visual>
      <collision name="drivewhl_r_link_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <pose>0 0 0 1.5708 0 0</pose>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00132</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00132</iyy>
          <iyz>0.0</iyz>
          <izz>0.0025</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="drivewhl_r_joint" type="revolute">
      <parent>base_link</parent>
      <child>drivewhl_r_link</child>
      <pose relative_to="base_link">0.0 -0.18 -0.05 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
      </axis>
    </joint>

    <!-- Front Caster -->
    <link name="front_caster">
      <pose relative_to="caster_joint"/>
      <visual name="front_caster_visual">
        <geometry>
          <sphere>
            <radius>0.06</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 1 1 1</ambient>
          <diffuse>0 1 1 1</diffuse>
        </material>
      </visual>
      <collision name="front_caster_collision">
        <geometry>
          <sphere>
            <radius>0.06</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00072</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00072</iyy>
          <iyz>0.0</iyz>
          <izz>0.00072</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_caster</child>
      <pose relative_to="base_link">0.14 0.0 -0.09 0 0 0</pose>
    </joint>

    <!-- Rear Caster -->
    <link name="rear_caster">
      <pose relative_to="rear_caster_joint"/>
      <visual name="rear_caster_visual">
        <geometry>
          <sphere>
            <radius>0.06</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 1 1 1</ambient>
          <diffuse>0 1 1 1</diffuse>
        </material>
      </visual>
      <collision name="rear_caster_collision">
        <geometry>
          <sphere>
            <radius>0.06</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.0</mu>
              <mu2>0.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00072</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00072</iyy>
          <iyz>0.0</iyz>
          <izz>0.00072</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="rear_caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>rear_caster</child>
      <pose relative_to="base_link">-0.14 0.0 -0.09 0 0 0</pose>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
      <pose relative_to="base_link">0.0 0.0 0.12 0 0 0</pose>
    </joint>

    <link name="lidar_link">
      <pose relative_to="lidar_joint"/>
      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="lidar_collision">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000041</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000041</iyy><iyz>0</iyz>
          <izz>0.00008</izz>
        </inertia>
      </inertial>

      <sensor name="lidar" type="gpu_lidar">
        <topic>scan</topic>
        <update_rate>20</update_rate>
        <gz_frame_id>laser</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>25.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
       </sensor>
    </link>

  </model>
</sdf>